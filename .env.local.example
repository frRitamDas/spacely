# Spacely environment variables
# Copy this file to .env.local for local development.

# Server variables
PROTECTED_PATHS="/auth/reset-password,/profile" # Optional, comma-separated protected paths
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key" # Required

# Client variables
NEXT_PUBLIC_TMDB_ACCESS_TOKEN="your_tmdb_access_token" # Required, TMDB Read Access Token (not API key)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co" # Required
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your_supabase_publishable_key" # Required
NEXT_PUBLIC_CAPTCHA_SITE_KEY="your_cloudflare_turnstile_site_key" # Optional
NEXT_PUBLIC_AVATAR_PROVIDER_URL="https://api.dicebear.com/9.x/initials/svg" # Optional
