# Spacely environment variables
# For local development, copy .env.local.example to .env.local.

# Required server variables
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key"

# Required client variables
NEXT_PUBLIC_TMDB_ACCESS_TOKEN="your_tmdb_access_token"
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your_supabase_publishable_key"

# Optional client variables
# NEXT_PUBLIC_CAPTCHA_SITE_KEY="your_cloudflare_turnstile_site_key"
# NEXT_PUBLIC_AVATAR_PROVIDER_URL="https://api.dicebear.com/9.x/initials/svg"

# Optional server variable
# PROTECTED_PATHS="/auth/reset-password,/profile"
